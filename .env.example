# Meta business_discovery. Both are required for the official collector.
# See README.md for how to create them. Development mode is enough.
META_ACCESS_TOKEN=
IG_USER_ID=
GRAPH_API_VERSION=v22.0

# Used only when the Meta token is missing, or Graph returns a permission error.
APIFY_TOKEN=
APIFY_ACTOR=apify~instagram-scraper

# Image tagging. A free key from Google AI Studio.
# If the model name returns 404, set one that accepts images, such as gemini-3.6-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Public Instagram Stories. One request per brand per run.
# https://storiesfly.com/developers/docs/user-stories
STORIESFLY_KEY=

# Optional overrides.
# DB_PATH=data/feed.db
# TAG_LIMIT=100
# PORT=3000
# CRON_SCHEDULE=0 8 * * *
